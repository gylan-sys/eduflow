rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isAdmin() { 
      return (isVerified() && getUserData().role == 'admin') || 
             (isSignedIn() && (request.auth.token.email == 'gkrismantara@gmail.com' || request.auth.token.email == 'admin@eduflow.com')); 
    }
    
    function isTeacher() { return isVerified() && getUserData().role == 'teacher'; }
    function isParent() { return isVerified() && getUserData().role == 'parent'; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Validation helpers
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.role in ['admin', 'teacher', 'parent'];
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isVerified() && isValidUser(incoming()) && incoming().uid == request.auth.uid) || isAdmin();
      allow update: if (isAdmin() || (isVerified() && request.auth.uid == userId)) && 
                    isValidUser(incoming()) &&
                    (isAdmin() || (incoming().uid == existing().uid && incoming().role == existing().role));
    }

    match /students/{studentId} {
      // List rules MUST check resource.data to avoid scraping
      allow list: if isVerified() && (isAdmin() || (isParent() && resource.data.parentId == request.auth.uid));
      allow get: if isVerified() && (isAdmin() || (isParent() && resource.data.parentId == request.auth.uid) || isTeacher());
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow list: if isVerified() && (
        isAdmin() || 
        resource.data.teacherId == request.auth.uid || 
        resource.data.parentId == request.auth.uid
      );
      allow get: if isVerified() && (
        isAdmin() || 
        resource.data.teacherId == request.auth.uid || 
        resource.data.parentId == request.auth.uid
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || (isTeacher() && existing().teacherId == request.auth.uid);
    }

    match /attendance/{attendanceId} {
      allow list: if isVerified() && (
        isAdmin() || 
        resource.data.teacherId == request.auth.uid || 
        resource.data.parentId == request.auth.uid
      );
      allow get: if isVerified() && (
        isAdmin() || 
        resource.data.teacherId == request.auth.uid || 
        resource.data.parentId == request.auth.uid
      );
      allow create: if isAdmin() || (isTeacher() && incoming().teacherId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /payments/{paymentId} {
      allow list: if isVerified() && (isAdmin() || (isParent() && resource.data.parentId == request.auth.uid));
      allow get: if isVerified() && (isAdmin() || (isParent() && resource.data.parentId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /progressReports/{reportId} {
      allow list: if isVerified() && (
        isAdmin() || 
        resource.data.teacherId == request.auth.uid || 
        resource.data.parentId == request.auth.uid
      );
      allow get: if isVerified() && (
        isAdmin() || 
        resource.data.teacherId == request.auth.uid || 
        resource.data.parentId == request.auth.uid
      );
      allow create, update: if isAdmin() || (isTeacher() && (incoming().teacherId == request.auth.uid || existing().teacherId == request.auth.uid));
    }

    match /config/app_settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }
  }
}
