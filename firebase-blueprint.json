{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "parent"] },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Information about a student",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "parentId": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "notes": { "type": "string" },
        "type": { "type": "string", "enum": ["shadow", "swimming", "both"] }
      },
      "required": ["name", "parentId"]
    },
    "Session": {
      "title": "Learning Session",
      "description": "A scheduled lesson or shadow teacher session",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "parentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "type": { "type": "string", "enum": ["shadow", "swimming"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "transportFee": { "type": "number" },
        "sessionFee": { "type": "number" }
      },
      "required": ["studentId", "parentId", "teacherId", "type", "startTime", "endTime", "status"]
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "Tracking presence for a specific session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "studentId": { "type": "string" },
        "parentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentPresent": { "type": "boolean" },
        "teacherPresent": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["sessionId", "studentId", "parentId", "teacherId", "studentPresent", "teacherPresent"]
    },
    "Payment": {
      "title": "Payment Record",
      "description": "Tracking tuition and transport payments",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "parentId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["tuition", "transport", "other"] },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "date": { "type": "string", "format": "date-time" },
        "month": { "type": "integer" },
        "year": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "required": ["studentId", "parentId", "amount", "status", "type", "month", "year"]
    },
    "ProgressReport": {
      "title": "Student Progress Report",
      "description": "Academic or skill performance updates",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "parentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "metrics": {
          "type": "object",
          "properties": {
            "focus": { "type": "integer" },
            "social": { "type": "integer" },
            "skill": { "type": "integer" }
          }
        }
      },
      "required": ["studentId", "teacherId", "content", "date"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "App users"
    },
    "students": {
      "schema": "Student",
      "description": "Students list"
    },
    "sessions": {
      "schema": "Session",
      "description": "Scheduled lessons"
    },
    "attendance": {
      "schema": "Attendance",
      "description": "Attendance history"
    },
    "payments": {
      "schema": "Payment",
      "description": "Payment transactions"
    },
    "progressReports": {
      "schema": "ProgressReport",
      "description": "Student performance history"
    }
  }
}
